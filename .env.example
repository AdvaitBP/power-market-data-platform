# Optional names reserved for future cloud phases; Phase 0 reads none of these.
# .env and .env.* are ignored by Git, except this file.
# No dotenv loader is installed. Do not put credentials in this example.
GCP_PROJECT_ID=your-gcp-project-id
# Choose a location when provisioning datasets; all joined datasets must agree.
BQ_LOCATION=US
BQ_RAW_DATASET=power_market_raw
BQ_ANALYTICS_DATASET=power_market_analytics
