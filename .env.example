# Non-secret process environment names; .env is ignored and not automatically loaded.
# Authenticate using user ADC. Never put credentials or tokens in this file or .env.
GCP_PROJECT_ID=your-dedicated-project-id
BQ_LOCATION=US
BQ_RAW_DATASET=power_market_raw
# Per-query safety ceiling: may be lowered, not raised above 100 MiB in Phase 2.
BQ_MAXIMUM_BYTES_BILLED=104857600
# Optional code commit identifier recorded in ingestion manifests.
PMD_CODE_REVISION=

# dbt output dataset; must differ from BQ_RAW_DATASET.
BQ_ANALYTICS_DATASET=power_market_analytics
