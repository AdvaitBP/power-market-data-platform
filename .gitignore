# Local Python environments and generated packaging files
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
/build/
/dist/

# Local configuration and credentials; only the example is public
.env
.env.*
!.env.example
/credentials/
/secrets/

# Validation caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pytype/
.pyre/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Generated dbt files (wherever a future dbt project lives)
**/target/
**/dbt_packages/
**/logs/
profiles.yml

# Local downloads, reports and scratch data, never test fixtures
/artifacts/
/data/
/tmp/
/work/
*.log

# Editor and OS state
.vscode/
.idea/
.DS_Store
Thumbs.db
